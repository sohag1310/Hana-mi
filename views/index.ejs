<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hanami HoHo | Premium Manga & Doujinshi Reader</title>
  <!-- Google Fonts: Inter, Space Grotesk & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tailwind Config or Font mappings -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
            display: ['Space Grotesk', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    /* Premium custom scrollbar styling */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0b0f19;
    }
    ::-webkit-scrollbar-thumb {
      background: #1f293d;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3b82f6;
    }
    body {
      background-color: #030712;
      color: #f3f4f6;
      font-family: 'Inter', sans-serif;
    }
    /* Subtle neon card glow on hover */
    .manga-card:hover {
      box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.2), 0 8px 10px -6px rgba(168, 85, 247, 0.2);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Premium Glassmorphic Header -->
  <header class="sticky top-0 z-50 bg-[#030712]/80 backdrop-blur-md border-b border-gray-800/80 px-4 py-4 md:px-8">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-pink-500 via-purple-500 to-indigo-500 flex items-center justify-center shadow-lg shadow-purple-500/20 group-hover:scale-105 transition-all">
          <span class="text-white font-bold text-xl font-display">H</span>
        </div>
        <div>
          <h1 class="text-2xl font-bold font-display tracking-tight bg-gradient-to-r from-pink-400 via-purple-400 to-indigo-400 bg-clip-text text-transparent group-hover:opacity-90 transition-opacity">
            Hanami HoHo
          </h1>
          <p class="text-[10px] font-mono uppercase tracking-widest text-purple-400/80">Premium Manga Platform</p>
        </div>
      </a>

      <!-- Compact Search Bar Form -->
      <form action="/" method="GET" class="flex-1 max-w-lg md:mx-8">
        <div class="relative group">
          <input 
            type="text" 
            name="search" 
            value="<%= search || '' %>"
            placeholder="Search manga, artists, doujinshi..." 
            class="w-full bg-[#0b0f19] text-gray-200 pl-11 pr-4 py-2.5 rounded-xl border border-gray-800 focus:border-purple-500 focus:outline-none transition-all group-hover:border-gray-700/80 text-sm placeholder-gray-500"
          />
          <span class="absolute left-4 top-3.5 text-gray-500 group-focus-within:text-purple-400 transition-colors">
            <!-- Search Icon -->
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </span>
          <% if (search) { %>
            <a href="/" class="absolute right-4 top-3 text-xs text-gray-500 hover:text-gray-300">Clear</a>
          <% } %>
        </div>
      </form>

      <!-- Connection Status indicator -->
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          REST API Live
        </span>
      </div>

    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8 md:px-8">
    
    <!-- Meta Summary Bar -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl font-bold font-display text-gray-100 flex items-center gap-2">
          <% if (search) { %>
            Search Results for "<span class="text-purple-400"><%= search %></span>"
          <% } else { %>
            🚀 Popular Releases
          <% } %>
        </h2>
        <p class="text-sm text-gray-400 font-sans mt-0.5">
          Curated English manga and doujinshi chapters directly from decentralized public indices.
        </p>
      </div>

      <!-- Compact Search Tags -->
      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/?search=color" class="px-2.5 py-1 rounded-lg bg-gray-900 border border-gray-800 text-gray-400 hover:text-gray-200 hover:border-gray-700 transition-all">#Full Color</a>
        <a href="/?search=romance" class="px-2.5 py-1 rounded-lg bg-gray-900 border border-gray-800 text-gray-400 hover:text-gray-200 hover:border-gray-700 transition-all">#Romance</a>
        <a href="/?search=doujinshi" class="px-2.5 py-1 rounded-lg bg-gray-900 border border-gray-800 text-gray-400 hover:text-gray-200 hover:border-gray-700 transition-all">#Doujinshi</a>
        <a href="/?search=comedy" class="px-2.5 py-1 rounded-lg bg-gray-900 border border-gray-800 text-gray-400 hover:text-gray-200 hover:border-gray-700 transition-all">#Comedy</a>
      </div>
    </div>

    <!-- Responsive Grid Layout -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
      <% if (galleries && galleries.length > 0) { %>
        <% galleries.forEach(function(item) { %>
          <div class="manga-card bg-[#0b0f19] rounded-2xl overflow-hidden border border-gray-800/60 p-2 flex flex-col group transition-all duration-300 hover:-translate-y-1">
            
            <!-- Cover Poster Container -->
            <a href="/reader?id=<%= item.id %>&token=<%= item.token %>" class="relative block overflow-hidden rounded-xl aspect-[2/3] bg-gray-950">
              <img 
                src="<%= item.cover %>" 
                alt="<%= item.title %>"
                loading="lazy" 
                referrerpolicy="no-referrer"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror="this.src='https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?w=400&q=80'"
              />
              
              <!-- Content Rating Badge -->
              <div class="absolute top-2 left-2 flex flex-col gap-1.5 align-start">
                <span class="px-2.5 py-0.5 rounded-md text-[10px] font-mono tracking-wider uppercase font-semibold text-white bg-gradient-to-r 
                  <%= item.category === 'Doujinshi' ? 'from-purple-600 to-indigo-600' : (item.category === 'Manga' ? 'from-pink-600 to-indigo-600' : 'from-gray-700 to-gray-800') %>">
                  <%= item.category %>
                </span>
              </div>

              <!-- Rating Score float bottom right -->
              <div class="absolute bottom-2 right-2 bg-gray-950/80 backdrop-blur-md border border-gray-800/80 rounded-md px-1.5 py-0.5 flex items-center gap-0.5 text-[10px] font-mono font-medium text-amber-400">
                ★ <span><%= item.rating %></span>
              </div>
            </a>

            <!-- Metadata Info -->
            <div class="pt-3 pb-1 px-1 flex flex-col flex-1">
              <a href="/reader?id=<%= item.id %>&token=<%= item.token %>" class="font-semibold text-xs text-gray-200 line-clamp-2 hover:text-purple-400 transition-colors font-sans mb-1" title="<%= item.title %>">
                <%= item.title %>
              </a>
              
              <div class="mt-auto flex flex-col gap-1.5">
                <!-- Tags section -->
                <% if (item.tags && item.tags.length > 0) { %>
                  <div class="flex flex-wrap gap-1 max-h-[36px] overflow-hidden">
                    <% item.tags.forEach(function(tag) { %>
                      <span class="text-[9px] font-mono text-gray-400 bg-gray-900 border border-gray-800 py-0.5 px-1.5 rounded-md truncate">
                        #<%= tag %>
                      </span>
                    <% }) %>
                  </div>
                <% } %>

                <!-- Post detail -->
                <div class="flex items-center justify-between text-[10px] text-gray-500 font-mono pt-1.5 border-t border-gray-800/60 mt-1">
                  <span class="truncate max-w-[80px]"><%= item.uploader || 'MangaDex' %></span>
                  <span><%= item.posted %></span>
                </div>
              </div>
            </div>

          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full py-16 text-center">
          <div class="w-16 h-16 bg-gray-900 border border-gray-800 rounded-full flex items-center justify-center mx-auto mb-4 text-purple-400">
            📭
          </div>
          <h3 class="text-xl font-bold font-display text-gray-300">No Manga Results Found</h3>
          <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto">
            Try revising your search query or check back later. Fallback datasets remain active if queries do not hit API filters.
          </p>
          <a href="/" class="inline-block mt-4 px-4 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-xl text-xs font-semibold hover:opacity-90">
            Go to popular list
          </a>
        </div>
      <% } %>
    </div>

    <!-- Simple Pagination Bar -->
    <div class="mt-12 flex justify-center items-center gap-4 border-t border-gray-900 pt-8">
      <% if (page > 0) { %>
        <a 
          href="/?search=<%= encodeURIComponent(search || '') %>&page=<%= page - 1 %>" 
          class="px-4 py-2 bg-gray-900 border border-gray-800 text-gray-300 font-semibold rounded-xl text-xs hover:border-gray-700 hover:text-white transition-all flex items-center gap-1"
        >
          ← Previous
        </a>
      <% } else { %>
        <span class="px-4 py-2 bg-gray-950/40 border border-gray-900 text-gray-700 rounded-xl text-xs cursor-not-allowed">
          ← Previous
        </span>
      <% } %>

      <span class="text-xs font-mono text-gray-400 bg-gray-950 border border-gray-900 px-3.5 py-2 rounded-xl">
        Page <span class="text-purple-400 font-bold"><%= page + 1 %></span>
      </span>

      <a 
        href="/?search=<%= encodeURIComponent(search || '') %>&page=<%= page + 1 %>" 
        class="px-4 py-2 bg-gray-900 border border-gray-800 text-gray-300 font-semibold rounded-xl text-xs hover:border-gray-700 hover:text-white transition-all flex items-center gap-1"
      >
        Next Page →
      </a>
    </div>

  </main>

  <footer class="bg-[#030712] border-t border-gray-900 py-8 px-4 text-center mt-16 text-xs text-gray-600 font-mono">
    <p class="max-w-xl mx-auto">
      Hanami HoHo operates strictly on secure, public domain MangaDex APIs and open CDN aggregates. No content is stored directly on local databases.
    </p>
    <p class="mt-2 text-[10px] text-gray-700">
      &copy; 2026 Hanami HoHo Network. Open Source, fully transparent.
    </p>
  </footer>

</body>
</html>