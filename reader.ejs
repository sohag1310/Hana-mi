<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Hanami HoHo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #030712; color: #f3f4f6; font-family: 'Inter', sans-serif; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #0b0f19; }
    ::-webkit-scrollbar-thumb { background: #1f293d; border-radius: 4px; }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-[#030712]/80 backdrop-blur-md border-b border-gray-800/80 px-4 py-4 md:px-8">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-pink-500 via-purple-500 to-indigo-500 flex items-center justify-center shadow-lg">
          <span class="text-white font-bold text-lg">H</span>
        </div>
        <span class="text-xl font-bold bg-gradient-to-r from-pink-400 via-purple-400 to-indigo-400 bg-clip-text text-transparent">Hanami HoHo</span>
      </a>
      <a href="/" class="text-xs font-mono text-gray-400 hover:text-white px-3 py-1.5 border border-gray-800 rounded-lg hover:border-gray-600 transition-all">
        ← Back to Library
      </a>
    </div>
  </header>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 py-8 md:px-8">

    <!-- Manga Meta Info -->
    <div class="mb-8 p-5 bg-[#0b0f19] rounded-2xl border border-gray-800/60">
      <div class="flex flex-wrap items-start gap-4">
        <div class="flex-1 min-w-0">
          <h1 class="text-lg font-bold text-gray-100 leading-tight mb-2"><%= title %></h1>
          <div class="flex flex-wrap gap-2 mb-3">
            <span class="px-2.5 py-0.5 rounded-md text-[10px] font-mono uppercase font-semibold text-white bg-gradient-to-r from-purple-600 to-indigo-600">
              <%= category %>
            </span>
            <span class="text-xs font-mono text-gray-500"><%= uploader %></span>
            <span class="text-xs font-mono text-gray-500"><%= posted %></span>
          </div>
          <% if (tags && tags.length > 0) { %>
            <div class="flex flex-wrap gap-1">
              <% tags.forEach(function(tag) { %>
                <span class="text-[9px] font-mono text-gray-400 bg-gray-900 border border-gray-800 py-0.5 px-1.5 rounded-md">#<%= tag %></span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <div class="text-right shrink-0">
          <p class="text-xs font-mono text-gray-500"><%= pages.length %> pages</p>
          <p class="text-xs font-mono text-purple-400 mt-1">Ch. <%= pageNo + 1 %></p>
        </div>
      </div>
    </div>

    <!-- Chapter Navigation Top -->
    <div class="flex justify-center gap-3 mb-6">
      <% if (pageNo > 0) { %>
        <a href="/reader?id=<%= id %>&token=<%= token %>&p=<%= pageNo - 1 %>"
           class="px-4 py-2 bg-gray-900 border border-gray-800 text-gray-300 font-semibold rounded-xl text-xs hover:border-gray-600 hover:text-white transition-all">
          ← Prev Chapter
        </a>
      <% } %>
      <span class="px-4 py-2 bg-gray-950 border border-gray-900 text-gray-400 rounded-xl text-xs font-mono">
        Chapter <span class="text-purple-400 font-bold"><%= pageNo + 1 %></span>
      </span>
      <a href="/reader?id=<%= id %>&token=<%= token %>&p=<%= pageNo + 1 %>"
         class="px-4 py-2 bg-gray-900 border border-gray-800 text-gray-300 font-semibold rounded-xl text-xs hover:border-gray-600 hover:text-white transition-all">
        Next Chapter →
      </a>
    </div>

    <!-- Pages -->
    <% if (pages && pages.length > 0) { %>
      <div class="flex flex-col items-center gap-2">
        <% pages.forEach(function(pg) { %>
          <div class="w-full max-w-2xl">
            <img
              src="<%= pg.url %>"
              alt="Page <%= pg.index %>"
              loading="lazy"
              referrerpolicy="no-referrer"
              class="w-full rounded-lg border border-gray-800/40"
              onerror="this.src='https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?w=800&q=80'"
            />
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="py-16 text-center">
        <div class="w-16 h-16 bg-gray-900 border border-gray-800 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">📭</div>
        <h3 class="text-xl font-bold text-gray-300">No Pages Found</h3>
        <p class="text-xs text-gray-500 mt-2">Could not load pages for this manga. Try another title.</p>
        <a href="/" class="inline-block mt-4 px-4 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-xl text-xs font-semibold hover:opacity-90">
          ← Return to Library
        </a>
      </div>
    <% } %>

    <!-- Chapter Navigation Bottom -->
    <div class="flex justify-center gap-3 mt-8 pt-8 border-t border-gray-900">
      <% if (pageNo > 0) { %>
        <a href="/reader?id=<%= id %>&token=<%= token %>&p=<%= pageNo - 1 %>"
           class="px-4 py-2 bg-gray-900 border border-gray-800 text-gray-300 font-semibold rounded-xl text-xs hover:border-gray-600 hover:text-white transition-all">
          ← Prev Chapter
        </a>
      <% } %>
      <a href="/" class="px-4 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-xl text-xs font-semibold hover:opacity-90">
        Back to Library
      </a>
      <a href="/reader?id=<%= id %>&token=<%= token %>&p=<%= pageNo + 1 %>"
         class="px-4 py-2 bg-gray-900 border border-gray-800 text-gray-300 font-semibold rounded-xl text-xs hover:border-gray-600 hover:text-white transition-all">
        Next Chapter →
      </a>
    </div>

  </main>

  <footer class="bg-[#030712] border-t border-gray-900 py-6 px-4 text-center mt-12 text-xs text-gray-700 font-mono">
    <p>&copy; 2026 Hanami HoHo Network. Open Source, fully transparent.</p>
  </footer>

</body>
</html>